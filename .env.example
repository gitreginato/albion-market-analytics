# ============================================================
# Albion Market Dashboard - Environment Variables
# Copy to .env and fill in if needed. Most features work without any keys.
# ============================================================

# Node environment (development | production)
NODE_ENV=development

# Optional: Port for dev server (default 3000)
# PORT=3000

# Note: This project uses the public Albion Online Data Project API.
# No API key is required. All data is fetched from:
# https://www.albion-online-data.com/
